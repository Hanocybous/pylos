[Unit]
Description=Pylos SSH Intrusion Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/pylos daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
# Without this, print() output is block-buffered and log lines reach the journal late.
Environment=PYTHONUNBUFFERED=1

# Sandbox: Pylos only needs to edit the firewall, read the journal and write its own files.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ConfigurationDirectory=pylos
StateDirectory=pylos
# /etc/pylos: config is created on first run. /run: iptables' xtables.lock.
ReadWritePaths=/etc/pylos /run

[Install]
WantedBy=multi-user.target
