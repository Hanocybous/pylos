#!/bin/bash
set -e

# Pre-removal script for Pylos (deb package)
# Be tolerant if systemd or files are missing

BIN_PATH=/usr/bin/pylos
SYSTEMD_UNIT=pylos.service

if command -v systemctl >/dev/null 2>&1; then
  systemctl stop "$SYSTEMD_UNIT" >/dev/null 2>&1 || true
  systemctl disable "$SYSTEMD_UNIT" >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

# Remove the global CLI symlink if present
rm -f "$BIN_PATH" || true

exit 0
