#!/bin/bash
set -e

# Post-install script for Pylos (deb package)
# This script is intentionally idempotent and tolerant of missing pieces

INSTALL_DIR=/opt/pylos
BIN_PATH=/usr/bin/pylos
SYSTEMD_UNIT=/etc/systemd/system/pylos.service
CONFIG_DIR=/etc/pylos
CONFIG_PATH=${CONFIG_DIR}/config.json
CONTRIB_DIR=${INSTALL_DIR}/contrib

# Create install dir if missing (package usually installs files under /opt/pylos)
mkdir -p "$INSTALL_DIR"

# Create or update symlink for the CLI
if [ -f "$INSTALL_DIR/pylos.py" ]; then
  ln -sf "$INSTALL_DIR/pylos.py" "$BIN_PATH"
fi

# Install systemd unit if present in package contrib
if [ -f "$CONTRIB_DIR/pylos.service" ]; then
  install -m 644 "$CONTRIB_DIR/pylos.service" "$SYSTEMD_UNIT"
fi

# Ensure configuration directory exists
mkdir -p "$CONFIG_DIR"

# Install example config only if a config does not already exist
if [ ! -f "$CONFIG_PATH" ]; then
  if [ -f "$CONTRIB_DIR/config.example.json" ]; then
    install -m 640 "$CONTRIB_DIR/config.example.json" "$CONFIG_PATH"
  else
    # Create a minimal config placeholder to avoid errors
    printf '%s\n' "{}" > "$CONFIG_PATH"
    chmod 640 "$CONFIG_PATH"
  fi
fi

# Reload systemd and enable/service the unit if systemctl is available
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  # Enable the unit if it exists
  if [ -f "$SYSTEMD_UNIT" ]; then
    systemctl enable --now pylos.service >/dev/null 2>&1 || systemctl restart pylos.service >/dev/null 2>&1 || true
  fi
fi

exit 0
