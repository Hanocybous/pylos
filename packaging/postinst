#!/bin/bash
set -e

# Post-install script for Pylos (deb package). Idempotent.
# The unit ships in /lib/systemd/system; pylos writes /etc/pylos/config.json with defaults on first run.

ln -sf /opt/pylos/pylos.py /usr/bin/pylos

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable pylos.service >/dev/null 2>&1 || true
  # restart, not just start: on upgrade the old code would otherwise keep running
  systemctl restart pylos.service >/dev/null 2>&1 || true
fi

exit 0
